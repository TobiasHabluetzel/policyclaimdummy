# Stage 1 — build the Claims Operations SPA
FROM node:20-alpine AS web
WORKDIR /app
COPY src/ClaimsOps.Web/package*.json ./
RUN npm ci
COPY src/ClaimsOps.Web/ ./
RUN npx vite build --outDir /web-dist --emptyOutDir

# Stage 2 — build the .NET API and bundle the SPA into wwwroot
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS api
WORKDIR /src
COPY src/Shared/ ./Shared/
COPY src/ClaimsOps.Api/ ./ClaimsOps.Api/
RUN dotnet restore ClaimsOps.Api/ClaimsOps.Api.csproj
COPY --from=web /web-dist ./ClaimsOps.Api/wwwroot/
RUN dotnet publish ClaimsOps.Api/ClaimsOps.Api.csproj -c Release -o /publish

# Stage 3 — runtime
FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app
COPY --from=api /publish .
EXPOSE 8080
CMD ["sh", "-c", "ASPNETCORE_HTTP_PORTS=${PORT:-8080} dotnet ClaimsOps.Api.dll"]
